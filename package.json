{
  "name": "filmexif",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://lbare.github.io/FilmEXIF/",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulators": "firebase emulators:start --project demo-filmexif",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@mantine/charts": "^9.7.4",
    "@mantine/core": "^9.7.4",
    "@mantine/dates": "^9.7.4",
    "@mantine/form": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/modals": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@phosphor-icons/react": "^2.1.10",
    "dayjs": "^1.11.23",
    "firebase": "^13.1.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
